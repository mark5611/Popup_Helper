{
  "manifest_version": 2,
  "name": "Helper.V1",
  "version": "1.0",
  "permissions": ["menus", "activeTab","search"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "@helper-by-mark",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "browser_action": {
    "default_title": "Helper"
  },

  "web_accessible_resources": ["helper_library.json"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
